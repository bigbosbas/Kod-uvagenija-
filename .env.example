# Скопировать в .env, заполнить реальными значениями. .env никогда не коммитить.

PORT=3000

# Postgres (Timeweb Cloud DBaaS)
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=true

# Robokassa (магазин "Privatebot")
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_MODE=false
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=

# S3 (Timeweb Cloud, приватный бакет с PDF)
S3_ENDPOINT=
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PDF_KEY=kod-uvazheniya.pdf

# Админка
ADMIN_JWT_SECRET=
